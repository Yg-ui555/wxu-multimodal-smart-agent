# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境
venv/
venv311/
venv_old/
.venv/

# 密钥
.env

# 数据（向量库、文档、用户历史）—— 体积大且含校内资料
data/

# 日志
logs/
*.log
*.tmp

# 备份文件
*.bak
*.bak.*

# 临时清理目录
scripts/cleanup_*/

# 评估运行产物（保留测试集 eval_set.json 和 bad_case 报告）
tests/eval_current*.json
tests/eval_baseline.json
tests/eval_current_with_hyde.json
tests/*.html

# 未跑完的评估产物（partial = 中途断掉的中间结果，不是结论）
tests/eval_*_partial.jsonl
# 评估集的中间版本与备份（只保留当前生效的那份）
tests/eval_set_*_backup.json
tests/eval_set_240.json

# 压测原始数据（脚本本身 locustfile.py 要传，数据不用）
tests/load_test_*.csv

# 根目录下的临时评估脚本（scripts/ 下的正式脚本要传）
/_run_eval_*.py

# IDE
.idea/
.vscode/
*.iml

# 操作系统
.DS_Store
Thumbs.db

# Gradio 运行时生成的证书/缓存（每次启动自动重建）
.gradio/

# 临时诊断/调试脚本（命名带 _ 前缀，正式脚本在 scripts/ 下不带前缀）
scripts/_*.py
scripts/_*.cjs
scripts/_diag/      # 调试脚本归类目录(2026-10-10 整理时统一放这里)
# *
