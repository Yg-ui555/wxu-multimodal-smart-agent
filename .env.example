# ============================================================
# WXU 多模态校园智能助手 · 环境变量样例
# 把 .env.example 复制成 .env，填入真实值即可。
#
# ⚠️ 2026-10-30 清理过一轮：这里**只保留代码真的会读的变量**
#    （每个都 grep 过全仓确认有 os.getenv 读取）。
#    检索参数 / 端口 / 开学日 / 抓取时间这些目前是**写死在代码里**的，
#    写进 .env 不生效 —— 见文件末尾的"写死在哪"对照表。
# ============================================================

# ===== LLM 主配置（必需）=====
# DeepSeek(默认) 或其他 OpenAI 兼容协议服务
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 嵌入模型（Ollama 本地）=====
# 代码里默认就是 bge-m3 + http://127.0.0.1:11434，
# 只有把嵌入服务换到别的机器/端口才需要改这一行
EMBED_BASE_URL=http://localhost:11434

# ===== Agent 引擎开关 =====
# 0 = 手写 ReAct 循环（src/agent/react_engine.py，默认）
# 1 = LangGraph 状态图（src/agent/langgraph_engine.py）
USE_LANGGRAPH_AGENT=0

# ===== 多跳检索开关 =====
# 0 = 单跳（默认）
# 1 = 启用 src/rag/multi_hop.py 的「query 拆解 + 多跳独立检索 + RRF 融合」
# ⚠️ 只对 src/rag/rag_engine.py 那条链路有效；
#    线上聊天的 Agent 检索工具（src/agent/tools/search_school_notices.py）
#    自建 HybridRetriever，**不读这个开关**。
USE_MULTIHOP=0

# ============================================================
# 📌 以下参数目前写死在代码里（.env 改了不生效，别写进来）
# ============================================================
# 检索参数   → src/rag/rag_engine.py：top_k=4 / vector_top_k=8 / bm25_top_k=8
#              use_reranker=False（CPU 跑 HF CrossEncoder 太慢，已做过消融实验）
#              use_hyde=False（每问多调一次 LLM，边际收益小）
#              Agent 侧同一套参数在 src/agent/tools/search_school_notices.py
# 服务端口   → src/web_app/fastapi_app.py：7862，host 写死 0.0.0.0
# 开学日期   → src/curriculum/settings.py：每用户一条记录，缺省是当天
# 抓取时间   → scripts/setup_scheduled_task.ps1：Windows 任务计划每天 06:00
#              （任务名 WXU_DailyCrawl_0600；scripts/daily_crawl.py 的 daemon
#               模式是另一条路，默认 18:00，生产走的是任务计划那条）
