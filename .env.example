# ============================================================
# WXU 多模态校园智能助手 · 环境变量样例
# 把 .env.example 复制成 .env，填入真实值即可。
# ============================================================

# ===== LLM 主配置（必需）=====
# DeepSeek(默认) 或其他 OpenAI 兼容协议服务
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 嵌入模型（Ollama 本地）=====
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# ===== 检索参数 =====
RETRIEVAL_TOP_K=4
VECTOR_TOP_K=8
BM25_TOP_K=8
USE_RERANKER=false
USE_HYDE=false

# ===== 学期配置 =====
# 默认开学日,用于自动算"第几周";前端 <a href="/schedule">/schedule</a> 里用户可以单独设置自己的
DEFAULT_SEMESTER_START=2026-09-01

# ===== 服务端口 =====
FASTAPI_PORT=7862
FASTAPI_HOST=0.0.0.0

# ===== 抓取任务 =====
# setup_scheduled_task.ps1 注册时使用
DAILY_CRAWL_HOUR=18